
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function getEmployee(uid) {
      return get(/databases/$(database)/documents/employees/$(uid)).data;
    }

    function isDirector() {
      return request.auth != null && (
        request.auth.token.email == 'omnia.taalab@nis-egypt.com' ||
        (exists(/databases/$(database)/documents/employees/$(request.auth.uid)) && 
         (getEmployee(request.auth.uid).role == 'Director' || getEmployee(request.auth.uid).role == 'Admin'))
      );
    }
    
    function isManager() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/employees/$(request.auth.uid)) && 
             getEmployee(request.auth.uid).role == 'Manager';
    }

    function isSalesManager() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/employees/$(request.auth.uid)) && 
             getEmployee(request.auth.uid).role == 'Sales Manager';
    }

    function isSales() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/employees/$(request.auth.uid)) && 
             (getEmployee(request.auth.uid).role == 'Sales' || getEmployee(request.auth.uid).role == 'Sales Manager');
    }

    match /employees/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /students/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    match /applications/{id} {
      allow read: if true;
      allow create: if true; 
      allow update: if request.auth != null || (request.auth == null && resource.data.status == 'Applicant');
      allow delete: if isDirector();
    }

    match /applications/{id}/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /counters/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /leads/{id} {
      allow read: if isSales();
      allow create: if isSales();
      allow update: if isSalesManager() || (isSales() && resource.data.assignedToId == request.auth.uid);
      allow delete: if isSalesManager() || isDirector();
    }
    
    match /settings/{id} {
      allow read: if true;
      allow write: if isDirector();
    }

    match /campus/{id} {
      allow read: if true;
      allow write: if isDirector();
    }

    match /schools/{id} {
      allow read: if true;
      allow write: if isDirector();
    }

    match /grade/{id} {
      allow read: if true;
      allow write: if isDirector();
    }

    match /campus_mappings/{id} {
      allow read: if true;
      allow write: if isDirector();
    }

    match /subject/{id} {
      allow read: if true;
      allow write: if isDirector();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isDirector();
    }

    match /roles/{id} {
      allow read: if true;
      allow write: if isDirector();
    }

    match /interview_questions/{id} {
      allow read: if true;
      allow write: if isDirector();
    }

    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if isDirector();
    }
  }
}
